<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Reading the audio files the user points us at (queried on first launch). -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <!-- Posting the playback notification. Asked for on its own: a library is useless without the
         audio permission, while the player works perfectly well with no notification at all. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Decoding and analysing a track carries on while the screen is off, so the CPU is held awake
         for the length of that work rather than for the whole session. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Playback carries on with the app off screen, under a media-playback foreground service.
         Without the promotion Android freezes the process the moment the app leaves the screen. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NeonPlayer">
        <!-- Portrait only, on purpose. This UI is a tall single-column stack, and rotating it would
             rebuild the activity, which tears down the decoded track and restarts the sound. The
             configChanges below are the ones we survive in place for the same reason: a day/night
             switch or a font size change must not stop the music either. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|density|fontScale|uiMode|locale|layoutDirection"
            android:theme="@style/Theme.NeonPlayer"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Hosts the media session the system's controls talk to, and keeps the process alive
             while something is playing. Not exported: only this app starts it. -->
        <service
            android:name=".data.PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>

</manifest>